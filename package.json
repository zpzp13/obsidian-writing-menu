{
	"name": "writing-menu",
	"version": "3.0.8",
	"description": "An Obsidian plugin for customizing editor formatting",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"postbuild": "node -e \"const fs=require('fs');const d='C:/Users/82109/Desktop/Obsidian/Test/.obsidian/plugins/writing-menu/';['main.js','styles.css','manifest.json'].forEach(f=>{try{fs.copyFileSync(f,d+f);console.log('copied',f);}catch(e){console.error('skip',f,e.message);}})\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@types/diff-match-patch": "^1.0.36",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"diff-match-patch": "^1.0.5",
		"ical.js": "^2.2.1",
		"moment": "^2.30.1"
	}
}